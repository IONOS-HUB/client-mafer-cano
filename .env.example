# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url_here
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
# Service role key — server-side only, never expose to the browser
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here


# Business Configuration
NEXT_PUBLIC_BUSINESS_NAME="MAFER CANO"
NEXT_PUBLIC_BUSINESS_RUC=your_ruc_here
NEXT_PUBLIC_BUSINESS_ADDRESS=your_address_here
NEXT_PUBLIC_BUSINESS_PHONE=your_phone_here

# SRI Nightly Retry
# Random secret shared between this app and the Supabase Edge Function
SRI_RETRY_SECRET=generate_a_random_secret_here
# Public URL of this app (used by the Edge Function to call /api/sri/retry-failed)
APP_URL=https://your-domain.com
